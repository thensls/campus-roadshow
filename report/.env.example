# NSLS Auth (OpenID Connect) — required in production.
# Add these to Vercel via `vercel env add` or the project dashboard.
# For local dev, copy to .env.local (gitignored).

OIDC_ISSUER_URL=https://auth.nsls.org
OIDC_CLIENT_ID=campus-roadshow
OIDC_CLIENT_SECRET=replace-with-value-from-auth-portal
OIDC_REDIRECT_URI=https://roadshow.nsls.org/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://roadshow.nsls.org/
OIDC_SCOPES=openid profile email

# Signs + encrypts the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-32-plus-hex-chars

# Airtable (existing — used by /api/pilot-survey-submit).
AIRTABLE_API_KEY=replace-with-token-with-data.records:write-on-app5rj9bOGQNFoIoD
